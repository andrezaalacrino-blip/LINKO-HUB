# Copie para .env.local (dev) ou configure no provedor de hospedagem (produção).
# NUNCA versione valores reais.

# --- Supabase (já usados pelo Hub) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Integração Meta / Instagram (Login do Facebook para Empresas + SUAT) ---
# Mantenha "false" até confirmar que https://hub.linko.ag/auth/meta/callback
# responde em produção (HTTPS válido). Só então mude para "true".
META_OAUTH_ENABLED=false

# Meta for Developers > App LINKO Hub > Configurações do app > Básico
# (ID do app e Chave secreta do app do FACEBOOK — não os do Instagram).
META_APP_ID=
META_APP_SECRET=

# Login do Facebook para Empresas > Configurações > ID da configuração
# (a configuração com token de usuário do sistema e ativos do Instagram).
META_LOGIN_CONFIG_ID=

# Precisa ser idêntica à URI cadastrada em
# Login do Facebook para Empresas > Configurações > URIs de redirecionamento do OAuth válidos.
META_REDIRECT_URI=https://hub.linko.ag/auth/meta/callback

# Versão da Graph API (opcional).
META_GRAPH_VERSION=v23.0

# 32 bytes aleatórios em base64 cada — gere com: openssl rand -base64 32
# Use valores DIFERENTES entre si e entre ambientes.
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_STATE_SECRET=
